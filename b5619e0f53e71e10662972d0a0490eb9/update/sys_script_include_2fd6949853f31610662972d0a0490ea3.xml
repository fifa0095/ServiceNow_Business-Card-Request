        <script><![CDATA[var ImsAjax = Class.create();
ImsAjax.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	getCardBucket:function()
	{
		var gr = new GlideRecord('x_1439619_business_business_card_bucket');
		gr.addQuery('employee',this.getParameter('sysparm_user'));
		gr.query();
		if(gr.next())
		{
			var CardDetail = {};
			CardDetail.limit ='' +gr.limit;
			return JSON.stringify(CardDetail);
		}
	},

    type: 'ImsAjax'
});]]></script>
